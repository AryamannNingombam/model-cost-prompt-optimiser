# Copy to `.env` in the repo root (never commit `.env`; it is gitignored).
# https://docs.fireworks.ai/ — create an API key under your workspace.

# ── Required for API calls ─────────────────────────────────────────────
FIREWORKS_API_KEY=fw_YOUR_API_KEY_HERE
FRIENDLY_API_KEY=flp_pphJgSkgfymHu9GRWRPyY783jxkYB73HpOGgfpPi1VQ56

# ── Inference endpoint (defaults to Fireworks hosted API) ─────────────
FIREWORKS_CHAT_COMPLETIONS_URL=https://api.fireworks.ai/inference/v1/chat/completions

# Model identifiers (Fireworks deployment paths).
# Replace with YOUR models — do not fork with someone else's account/deploy ID.
FIREWORKS_OPTIMIZER_MODEL=accounts/fireworks/models/minimax-m2p5
FIREWORKS_EVALUATION_MODEL=accounts/fireworks/models/qwen2p5-7b-instruct

# ── HTTP (optional) ──────────────────────────────────────────────────
# Timeouts in seconds (float allowed)
FIREWORKS_OPTIMIZER_TIMEOUT_SECONDS=120
FIREWORKS_EVALUATION_TIMEOUT_SECONDS=60

# Rare: only if you intentionally use plain HTTP proxy (avoid in production).
# FIREWORKS_ALLOW_INSECURE_HTTP=false

# Log HTTP status and response size on errors (never logs full bodies).
# PROMPT_OPTIMIZER_VERBOSE_HTTP=false

# ── Paths (optional; defaults shown) ────────────────────────────────
# PROMPT_OPTIMIZER_VARIABLES_JSON=variables.json
# PROMPT_OPTIMIZER_OUTPUT_DIR=optimized_prompts
# PROMPT_OPTIMIZER_GROUND_TRUTH_CSV=.uploads/ground_truth.csv
# PROMPT_OPTIMIZER_PREDICTIONS_CSV=results.csv
